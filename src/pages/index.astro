---
import Layout from '@layouts/BookMeLayout.astro';
import { cvData } from '@components/cv/cvData';
import { getCareerTenure } from '@lib/career-tenure';
import { ROUTES } from '@lib/routes';
---

<Layout title='Luiz Gonzaga'>
  <main class='max-w-4xl mx-auto px-4 py-12'>
    <div class='text-center mb-12'>
      <h1 class='text-4xl font-bold mb-4'>Hi, I'm Luiz</h1>
      <p class='text-xl text-gray-600 dark:text-gray-300'><em>I like software and people :)</em></p>
    </div>

    <section class='max-w-2xl mx-auto mb-12'>
      <h2 class='text-2xl font-semibold mb-4 text-center'>Engineering leader & mentor</h2>
      <p class='text-lg text-gray-700 dark:text-gray-200'>
        I'm a people-centric engineering leader with ~{getCareerTenure()} years scaling both product and platform orgs across big-tech,
        startups and government; currently leading Platform efforts and the AI transformation at Coursera. I mentor engineers, engineering
        leaders and offer technical consultation for other companies, research groups or investment firms.
      </p>
    </section>

    <h2 class='text-2xl font-semibold mb-8 text-center'>Explore</h2>
    <div class='grid md:grid-cols-3 gap-12'>
      <div class='bg-white dark:bg-gray-900 p-8 rounded-lg shadow-sm hover:shadow-md transition-shadow'>
        <h3 class='text-2xl font-semibold mb-4'>View My CV</h3>
        <p class='text-gray-600 dark:text-gray-300 mb-6'>Explore my professional experience, skills, and achievements.</p>
        <div class='space-y-3'>
          <a
            href={ROUTES.cv}
            class='inline-block w-full bg-blue-600 dark:bg-blue-700 text-white text-center py-3 px-4 rounded-lg hover:bg-blue-700 dark:hover:bg-blue-600 transition duration-200'
          >
            View CV
          </a>
          <a
            href={ROUTES.cvPdf}
            class='inline-block w-full border-2 border-blue-600 dark:border-blue-500 text-blue-600 dark:text-blue-400 text-center py-3 px-4 rounded-lg hover:bg-blue-50 dark:hover:bg-blue-900/30 transition duration-200'
          >
            Download PDF
          </a>
        </div>
      </div>

      <div class='bg-white dark:bg-gray-900 p-8 rounded-lg shadow-sm hover:shadow-md transition-shadow'>
        <h3 class='text-2xl font-semibold mb-4'>Book a Session</h3>
        <p class='text-gray-600 dark:text-gray-300 mb-6'>Schedule a session for personalized guidance on your tech career.</p>
        <a
          href={ROUTES.bookMe}
          class='inline-block w-full bg-blue-600 dark:bg-blue-700 text-white text-center py-3 px-4 rounded-lg hover:bg-blue-700 dark:hover:bg-blue-600 transition duration-200'
        >
          Book Now
        </a>
      </div>

      <div class='bg-white dark:bg-gray-900 p-8 rounded-lg shadow-sm hover:shadow-md transition-shadow'>
        <h3 class='text-2xl font-semibold mb-4'>Get in Touch</h3>
        <p class='text-gray-600 dark:text-gray-300 mb-6'>
          Contact me for consultation work, speaking engagements or any other topic.
        </p>
        <a
          href={ROUTES.contact}
          class='inline-block w-full bg-blue-600 dark:bg-blue-700 text-white text-center py-3 px-4 rounded-lg hover:bg-blue-700 dark:hover:bg-blue-600 transition duration-200'
        >
          Contact Me
        </a>
      </div>
    </div>
  </main>
</Layout>
