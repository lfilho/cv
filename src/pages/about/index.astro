---
import PageLayout from '@layouts/PageLayout.astro';
import PageMeta from '@components/PageMeta.astro';
import { SITE_URL } from '@config';
import { ROUTES } from '@lib/routes';

const canonicalUrl = new URL(Astro.url.pathname, SITE_URL).href;
---

<PageLayout>
  <PageMeta
    slot='meta'
    title='About me'
    description='Luiz Gonzaga is a people-centric software engineering leader focused on developer experience, AI adoption, and building high-performing teams.'
    canonicalUrl={canonicalUrl}
  />
  <Fragment slot='main'>
    <h1 class='text-3xl font-bold mb-6'>About me</h1>

    <p class='mb-4'>
      I'm Luiz Gonzaga dos Santos Filho, a software engineering leader based in Vancouver area, Canada. Over the decades I've
      built and scaled engineering teams across big-tech, startups, government and everything in-between.
    </p>

    <p class='mb-4'>
      Today I lead Platform efforts and the AI transformation at Coursera, where I focus on making engineers more productive
      through agentic platforms, tools, practices, and AI effiency. I believe the best engineering organizations are built on
      relentlessly seeking business impact, psychological safety, high ownership and work-life balance.
    </p>

    <p class='mb-4'>
      My leadership style is people-first. I mentor engineers and engineering leaders, help teams adopt AI in pragmatic ways, and
      work to create environments where engineers can do their best work. I'm equally comfortable discussing system architecture,
      org design, hiring strategy, or the human side of modern work environments.
    </p>

    <p class='mb-4'>
      Outside of my day job, I offer mentorship, speak at engineering leadership events, and provide technical consultation to
      other companies, research groups or investment firms. I'm a lifelong learner, and someone who genuinely enjoys connecting
      with people and improving things around me.
    </p>

    <p class='mb-4'>
      I also hold a dual Canadian-Brazillian citenzship and can be an asset helping expand your organization's presence in those
      countries.
    </p>
  </Fragment>
</PageLayout>
