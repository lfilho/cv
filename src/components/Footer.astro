---
import { library } from '@fortawesome/fontawesome-svg-core';
import { faGithub, faLinkedin } from '@fortawesome/free-brands-svg-icons';
import { faHandshake } from '@fortawesome/free-regular-svg-icons';
import { faChalkboardTeacher } from '@fortawesome/free-solid-svg-icons';
import { FontAwesomeIcon } from '@fortawesome/react-fontawesome';
import '@fortawesome/fontawesome-svg-core/styles.css';
import { cvData } from '@components/cv/cvData';
import { ROUTES } from '@lib/routes';

library.add(faGithub, faLinkedin, faChalkboardTeacher, faHandshake);
---

<footer class='max-w-4xl mx-auto px-4 pt-4 pb-8 mt-8 border-t border-gray-200 dark:border-gray-700'>
  <div class='flex justify-center gap-6'>
    <a
      href={cvData.header.contact.linkedin.href}
      class='unset text-gray-600 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 relative group'
      target='_blank'
      title='See my profile on LinkedIn'
    >
      <FontAwesomeIcon icon={faLinkedin} className='text-2xl' client:load />
      <span
        class='absolute -top-8 left-1/2 -translate-x-1/2 bg-gray-800 dark:bg-gray-700 text-white text-sm py-1 px-2 rounded opacity-0 group-hover:opacity-100 whitespace-nowrap transition-opacity'
      >
        See my profile on LinkedIn
      </span>
    </a>

    <a
      href={cvData.header.contact.github.href}
      class='unset text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-gray-100 relative group'
      target='_blank'
      title='See my profile on GitHub'
    >
      <FontAwesomeIcon icon={faGithub} className='text-2xl' />
      <span
        class='absolute -top-8 left-1/2 -translate-x-1/2 bg-gray-800 dark:bg-gray-700 text-white text-sm py-1 px-2 rounded opacity-0 group-hover:opacity-100 whitespace-nowrap transition-opacity'
      >
        See my profile on GitHub
      </span>
    </a>

    <a
      href={cvData.header.contact.speakerdeck.href}
      class='unset text-gray-600 dark:text-gray-300 hover:text-orange-600 dark:hover:text-orange-400 relative group'
      target='_blank'
      title='See my presentations on SpeakerDeck'
    >
      <FontAwesomeIcon icon={faChalkboardTeacher} className='text-2xl' />
      <span
        class='absolute -top-8 left-1/2 -translate-x-1/2 bg-gray-800 dark:bg-gray-700 text-white text-sm py-1 px-2 rounded opacity-0 group-hover:opacity-100 whitespace-nowrap transition-opacity'
      >
        See my presentations on SpeakerDeck
      </span>
    </a>

    <a
      href={cvData.header.contact.topmate.href}
      class='unset text-gray-600 dark:text-gray-300 hover:text-green-600 dark:hover:text-green-400 relative group'
      target='_blank'
      title='Book a mentoring session on Topmate'
    >
      <FontAwesomeIcon icon={faHandshake} className='text-2xl' client:load />
      <span
        class='absolute -top-8 left-1/2 -translate-x-1/2 bg-gray-800 dark:bg-gray-700 text-white text-sm py-1 px-2 rounded opacity-0 group-hover:opacity-100 whitespace-nowrap transition-opacity'
      >
        Book a mentoring session on Topmate
      </span>
    </a>
  </div>
  <div class='mt-6 flex justify-center gap-4 text-sm text-gray-600 dark:text-gray-300'>
    <a href={ROUTES.home} class='unset hover:text-blue-600 dark:hover:text-blue-400'>Home</a>
    <span aria-hidden='true'>·</span>
    <a href={ROUTES.about} class='unset hover:text-blue-600 dark:hover:text-blue-400'>About</a>
    <span aria-hidden='true'>·</span>
    <a href={ROUTES.cv} class='unset hover:text-blue-600 dark:hover:text-blue-400'>CV</a>
    <span aria-hidden='true'>·</span>
    <a href={ROUTES.bookMe} class='unset hover:text-blue-600 dark:hover:text-blue-400'>Book me</a>
    <span aria-hidden='true'>·</span>
    <a href={ROUTES.contact} class='unset hover:text-blue-600 dark:hover:text-blue-400'>Contact</a>
    <span aria-hidden='true'>·</span>
    <a href={ROUTES.privacy} class='unset hover:text-blue-600 dark:hover:text-blue-400'>Privacy</a>
  </div>
</footer>
