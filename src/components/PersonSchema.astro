---
import { cvData, cvKeywords } from '@components/cv/cvData';
import { SITE_URL } from '@config';
import { parseCvDate } from '@lib/parse-cv-dates';
import { stripHtml } from '@lib/strip-html';

const { header, recruiting } = cvData;
const name = `${header.name.first} ${header.name.last}, ${header.name.title}`;
const plainDescription = stripHtml(header.introduction.join(' '), { replaceCareerTenure: true });

const worksForHistory = cvData.experience.softwareEngineering.map(job => {
  const latestTitle = job.positions[job.positions.length - 1] || 'Engineering Leader';
  return {
    '@type': 'OrganizationRole',
    roleName: latestTitle,
    worksFor: {
      '@type': 'Organization',
      name: job.company,
    },
    startDate: parseCvDate(job.startDate),
    endDate: job.endDate.toLowerCase() === 'present' ? undefined : parseCvDate(job.endDate, { lastDayOfMonth: true }),
  };
});

const alumniOf = cvData.education.academyCourses.map(degree => ({
  '@type': 'EducationalOrganization',
  name: degree.school,
}));

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name,
  description: plainDescription,
  url: SITE_URL,
  email: `mailto:${header.contact.email.href}`,
  jobTitle: 'Engineering Leader',
  worksFor: worksForHistory,
  alumniOf,
  address: {
    '@type': 'PostalAddress',
    addressLocality: header.location.city,
    addressCountry: header.location.country,
  },
  sameAs: [
    header.contact.linkedin.href,
    header.contact.github.href,
    header.contact.speakerdeck.href,
    header.contact.topmate.href,
  ],
  knowsAbout: cvKeywords.slice(0, 30),
  hasOccupation: {
    '@type': 'Occupation',
    name: 'Engineering Leader',
    description: 'Engineering leader targeting director/VP-level scope in next role',
    skills: cvKeywords.slice(0, 20),
  },
  subjectOf: [
    {
      '@type': 'WebPage',
      url: `${SITE_URL}/resume.json`,
      name: 'Structured Resume (JSON Resume)',
    },
    {
      '@type': 'WebPage',
      url: `${SITE_URL}/cv/for-recruiters.md`,
      name: 'For Recruiters',
    },
  ],
  // Recruiting intent expressed as a custom property (ignored by Schema.org validators but useful for agents).
  seeks: {
    '@type': 'JobPosting',
    title: recruiting.seniorityTarget,
    description: recruiting.availabilityNote,
    industry: recruiting.preferredIndustries,
    jobLocation: recruiting.preferredLocations.map(loc => ({
      '@type': 'Place',
      name: loc,
    })),
  },
};
---

<script type='application/ld+json' set:html={JSON.stringify(schema)} />
