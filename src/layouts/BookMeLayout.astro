---
interface Props {
  title: string;
  description?: string;
}

import '../styles/main-page.css';
import PageMeta from '@components/PageMeta.astro';
import PersonSchema from '@components/PersonSchema.astro';
import AgentDiscoveryLinks from '@components/AgentDiscoveryLinks.astro';
import WebMCP from '@components/WebMCP.astro';
import { SITE_URL, SITE_DESCRIPTION } from '@config';

import Favicon from './Favicon.astro';
import { stripHtml } from '@lib/strip-html';

const { title, description } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, SITE_URL).href;
const plainDescription = description || stripHtml(SITE_DESCRIPTION, { replaceCareerTenure: true });
---

<!doctype html>
<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width' />
    <PageMeta title={title} description={plainDescription} canonicalUrl={canonicalUrl} />

    <Favicon />
    <PersonSchema />

    <AgentDiscoveryLinks />
    <WebMCP />
  </head>
  <body class='bg-white dark:bg-gray-950 text-gray-900 dark:text-gray-100 min-h-screen'>
    <slot />
  </body>
</html>
